{
  "name": "opencode-workflow-guard",
  "version": "1.7.1",
  "description": "OpenCode plugin enforcing workflow discipline through deterministic tool.execute.before hooks",
  "license": "MIT",
  "type": "module",
  "main": "src/workflow-guard.ts",
  "bin": {
    "opencode-workflow-guard": "./bin/opencode-workflow-guard.mjs"
  },
  "exports": {
    ".": "./src/workflow-guard.ts",
    "./server": "./src/workflow-guard.ts",
    "./tui": "./src/workflow-guard-ui.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultus-net/opencode-workflow-guard.git"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "ACKNOWLEDGEMENTS.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "guard",
    "workflow"
  ],
  "scripts": {
    "test": "node test/test.mts",
    "test:install": "node test/test-e2e.mts",
    "test:all": "npm run typecheck && npm test && npm run test:install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "@opentui/solid": "latest",
    "jsonc-parser": "latest"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
