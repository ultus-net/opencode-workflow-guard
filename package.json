{
  "name": "opencode-workflow-guard",
  "version": "1.0.0",
  "description": "OpenCode plugin enforcing workflow discipline through deterministic tool.execute.before hooks",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ultus-net/opencode-workflow-guard.git"
  },
  "files": [
    "workflow-guard.ts",
    "workflow-guard-ui.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "guard",
    "workflow"
  ],
  "scripts": {
    "test": "node test.mts",
    "test:install": "node test-e2e.mts",
    "test:all": "npm run typecheck && npm test && npm run test:install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "^0.5.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "devDependenciesMeta_comment": "only needed for type-checking; opencode resolves this itself at runtime"
}
