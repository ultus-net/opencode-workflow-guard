{
  "name": "opencode-workflow-guard",
  "version": "1.16.0",
  "description": "Deterministic workflow and safety policy enforcement for OpenCode",
  "license": "MIT",
  "type": "module",
  "main": "src/workflow-guard.ts",
  "bin": {
    "opencode-workflow-guard": "./bin/opencode-workflow-guard.mjs"
  },
  "exports": {
    ".": "./src/workflow-guard.ts",
    "./server": "./src/workflow-guard.ts",
    "./tui": "./src/workflow-guard-ui.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultus-net/opencode-workflow-guard.git"
  },
  "files": [
    "bin/",
    "docs/",
    "src/",
    "test/",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "ACKNOWLEDGEMENTS.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "guard",
    "workflow"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node test/run-test.mjs",
    "test:install": "node test/test-e2e.mts",
    "test:all": "npm run typecheck && npm test && npm run test:install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.32",
    "@opencode/plugin": "2.1.3",
    "@opentui/solid": "0.6.6",
    "jsonc-parser": "3.3.1",
    "@opencode/ai": "2.1.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "solid-js": "1.9.17",
    "toml": "5.0.1"
  }
}
